 
create_project prj ./prj -part xczu3eg-sbva484-1-i -force
set_property board_part avnet.com:ultra96v2:part0:1.1 [current_project]
create_bd_design "design_1"
update_compile_order -fileset sources_1
startgroup
create_bd_cell -type ip -vlnv xilinx.com:ip:zynq_ultra_ps_e:3.4 zynq_ultra_ps_e_0
endgroup
apply_bd_automation -rule xilinx.com:bd_rule:zynq_ultra_ps_e -config {apply_board_preset "1" }  [get_bd_cells zynq_ultra_ps_e_0]
set_property CONFIG.PSU__UART0__PERIPHERAL__ENABLE {0} [get_bd_cells zynq_ultra_ps_e_0]
add_files -norecurse {../hdl/fifo_stream_out.v ../hdl/toggle_detect.v ../hdl/SynFIFO.v ../hdl/axi2stream_v2_0.v ../hdl/fifo_stream_in.v}
update_compile_order -fileset sources_1
update_compile_order -fileset sources_1
set_property  ip_repo_paths  ./my_ip [current_project]
update_ip_catalog
create_bd_cell -type module -reference axi2stream_v2_0 axi2stream_v2_0_0
apply_bd_automation -rule xilinx.com:bd_rule:axi4 -config { Clk_master {Auto} Clk_slave {Auto} Clk_xbar {Auto} Master {/zynq_ultra_ps_e_0/M_AXI_HPM0_FPD} Slave {/axi2stream_v2_0_0/s00_axi} ddr_seg {Auto} intc_ip {New AXI Interconnect} master_apm {0}}  [get_bd_intf_pins axi2stream_v2_0_0/s00_axi]
apply_bd_automation -rule xilinx.com:bd_rule:axi4 -config { Clk_master {Auto} Clk_slave {/zynq_ultra_ps_e_0/pl_clk0 (100 MHz)} Clk_xbar {/zynq_ultra_ps_e_0/pl_clk0 (100 MHz)} Master {/zynq_ultra_ps_e_0/M_AXI_HPM1_FPD} Slave {/axi2stream_v2_0_0/s00_axi} ddr_seg {Auto} intc_ip {/ps8_0_axi_periph} master_apm {0}}  [get_bd_intf_pins zynq_ultra_ps_e_0/M_AXI_HPM1_FPD]
regenerate_bd_layout
startgroup
set_property CONFIG.PSU__USE__S_AXI_GP0 {1} [get_bd_cells zynq_ultra_ps_e_0]
endgroup
startgroup
create_bd_cell -type ip -vlnv user.org:user:datamover_m1_m_axi:1.0 datamover_m1_m_axi_0
endgroup
apply_bd_automation -rule xilinx.com:bd_rule:axi4 -config { Clk_master {Auto} Clk_slave {Auto} Clk_xbar {Auto} Master {/datamover_m1_m_axi_0/m_axi_m1} Slave {/zynq_ultra_ps_e_0/S_AXI_HPC0_FPD} ddr_seg {Auto} intc_ip {New AXI SmartConnect} master_apm {0}}  [get_bd_intf_pins zynq_ultra_ps_e_0/S_AXI_HPC0_FPD]
regenerate_bd_layout
connect_bd_net [get_bd_pins datamover_m1_m_axi_0/ACLK_EN] [get_bd_pins rst_ps8_0_100M/peripheral_aresetn]
connect_bd_net [get_bd_pins rst_ps8_0_100M/peripheral_reset] [get_bd_pins datamover_m1_m_axi_0/ARESET]
set_property location {2 526 220} [get_bd_cells axi2stream_v2_0_0]
connect_bd_net [get_bd_pins datamover_m1_m_axi_0/wr_addr_ready] [get_bd_pins axi2stream_v2_0_0/fifo_wr_addr_len_ready]
connect_bd_net [get_bd_pins datamover_m1_m_axi_0/wr_data_ready] [get_bd_pins axi2stream_v2_0_0/fifo_wr_data_ready]
connect_bd_net [get_bd_pins datamover_m1_m_axi_0/wr_resp_valid] [get_bd_pins axi2stream_v2_0_0/fifo_wr_resp_valid]
connect_bd_net [get_bd_pins datamover_m1_m_axi_0/rd_addr_ready] [get_bd_pins axi2stream_v2_0_0/fifo_rd_addr_len_ready]
connect_bd_net [get_bd_pins datamover_m1_m_axi_0/rd_data] [get_bd_pins axi2stream_v2_0_0/fifo_rd_data]
connect_bd_net [get_bd_pins datamover_m1_m_axi_0/rd_data_valid] [get_bd_pins axi2stream_v2_0_0/fifo_rd_data_valid]
startgroup
create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 xlconstant_0
endgroup
set_property -dict [list \
  CONFIG.CONST_VAL {0} \
  CONFIG.CONST_WIDTH {32} \
] [get_bd_cells xlconstant_0]
connect_bd_net [get_bd_pins xlconstant_0/dout] [get_bd_pins axi2stream_v2_0_0/fifo_wr_resp]
set_property location {0.5 -206 48} [get_bd_cells axi2stream_v2_0_0]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_wr_addr] [get_bd_pins datamover_m1_m_axi_0/wr_addr]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_wr_len] [get_bd_pins datamover_m1_m_axi_0/wr_addr_len]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_wr_addr_len_valid] [get_bd_pins datamover_m1_m_axi_0/wr_addr_valid]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_wr_data] [get_bd_pins datamover_m1_m_axi_0/wr_data]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_wr_data_be] [get_bd_pins datamover_m1_m_axi_0/wr_data_be]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_wr_data_valid] [get_bd_pins datamover_m1_m_axi_0/wr_data_valid]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_rd_addr] [get_bd_pins datamover_m1_m_axi_0/rd_addr]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_rd_len] [get_bd_pins datamover_m1_m_axi_0/rd_addr_len]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_rd_addr_len_valid] [get_bd_pins datamover_m1_m_axi_0/rd_addr_valid]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_rd_data_ready] [get_bd_pins datamover_m1_m_axi_0/rd_data_ready]
connect_bd_net [get_bd_pins axi2stream_v2_0_0/fifo_wr_resp_ready] [get_bd_pins datamover_m1_m_axi_0/wr_resp_ready]
validate_bd_design
make_wrapper -files [get_files ./prj/prj.srcs/sources_1/bd/design_1/design_1.bd] -top
add_files -norecurse ./prj/prj.gen/sources_1/bd/design_1/hdl/design_1_wrapper.v
update_compile_order -fileset sources_1
# Disabling source management mode.  This is to allow the top design properties to be set without GUI intervention.
set_property source_mgmt_mode None [current_project]
set_property top design_1_wrapper [current_fileset]
# Re-enabling previously disabled source management mode.
set_property source_mgmt_mode All [current_project]
update_compile_order -fileset sources_1
regenerate_bd_layout
launch_runs impl_1 -to_step write_bitstream -jobs 4
wait_on_run impl_1
write_hw_platform -fixed -include_bit -force -file ./prj/design_1_wrapper.xsa
